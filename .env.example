# MediKiosk+ Backend Environment Configuration
PROJECT_NAME="MediKiosk+ Backend API"
VERSION="0.1.0"
DEBUG=True

# Database (PostgreSQL)
# For local Docker: postgresql://medikiosk:medikiosk_secret@localhost:5433/medikiosk_db
# For local SQLite fallback (tests/dev without Docker): sqlite:///./medikiosk.db
DATABASE_URL=postgresql://medikiosk:medikiosk_secret@localhost:5433/medikiosk_db

# OCR & Entity Extraction Configuration
OCR_CONFIDENCE_THRESHOLD=0.60
OCR_LANG=en
UPLOAD_DIR=./uploads

# Optional LLM API Key (for LLM-assisted entity extraction; deterministic fallback is active by default)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
